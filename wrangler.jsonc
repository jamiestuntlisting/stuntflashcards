{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stunt-flashcards",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "vars": {
    // Comma-separated host suffixes the /api/list endpoint is allowed to fetch.
    // "stuntlisting.com" also covers subdomains like site.staging.stuntlisting.com.
    "ALLOWED_HOSTS": "stuntlisting.com"
  },
  "observability": {
    "enabled": true
  }
}
